{
  "name": "ppobku",
  "main": "worker.js",
  "compatibility_date": "2026-09-08",
  "d1_databases": [
    {
      "binding": "ppobku_db",
      "database_name": "ppobku-db",
      "database_id": "955e9c73-6db8-48c2-bff9-ffef2aa73484",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "bucket_name": "ppobku-files",
      "binding": "ppobku_files",
      "remote": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "vars": {
    "DIGIFLAZZ_GATEWAY_URL": "https://gateway.bayora.my.id"
  }
}
